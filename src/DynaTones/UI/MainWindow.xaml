<Window x:Class="DynaTones.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:DynaTones.UI"
        Title="DynaTones" Width="1120" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text2}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========== Header, reaching into the title bar ========== -->
        <Border Background="{DynamicResource HeroBg}">
            <StackPanel>
                <Grid Height="32">
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Image x:Name="CaptionIcon" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="DynaTones" FontSize="12" Foreground="{DynamicResource HeroText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" />
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" />
                        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" />
                    </StackPanel>
                </Grid>

                <Grid Margin="32,8,32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource HeroTitle}" Text="DynaTones" />
                        <TextBlock x:Name="SummaryText" FontSize="13" Foreground="{DynamicResource HeroText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,6,0,0">
                        <!-- Refresh is a small icon: DynaTones keeps the screen right by itself, this is for when it could not -->
                        <Button x:Name="RefreshButton" Style="{StaticResource HeroButton}" Click="Refresh_Click" Margin="0,0,8,0" Width="32" Padding="0">
                            <!-- Turns while it works, at least once, as StartQueue's Check (Motion.SpinWhile) -->
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="RefreshTurn" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>
                        <Button x:Name="PauseButton" Style="{StaticResource HeroButton}" Click="Pause_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PauseIcon" FontFamily="{StaticResource IconFont}" Text="&#xE769;" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock x:Name="PauseText" Margin="8,0,0,0" />
                                <TextBlock x:Name="PauseChevron" FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Click="AddPackage_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock x:Name="AddButtonText" Margin="8,0,0,0" />
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Tabs left, settings far right on the same line, as in StartQueue; in the settings the gear turns into × -->
                <Grid Margin="32,18,32,0">
                    <StackPanel x:Name="TabsPanel" Orientation="Horizontal">
                        <RadioButton x:Name="TabBackground" Style="{StaticResource HeroTab}" IsChecked="True" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabMode" Style="{StaticResource HeroTab}" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabProfiles" Style="{StaticResource HeroTab}" Checked="Tab_Checked" />
                    </StackPanel>
                    <ToggleButton x:Name="GearButton" Style="{StaticResource HeroIconToggle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,-7,0,0" Checked="Gear_Changed" Unchecked="Gear_Changed">
                        <TextBlock x:Name="GearIcon" Text="&#xE713;" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="GearTurn" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </ToggleButton>
                </Grid>
            </StackPanel>
        </Border>
        <Rectangle Grid.Row="1" Height="3" Fill="{DynamicResource AccentGradient}" />

        <!-- ========== Background: what shows now, the way into desktop and lock screen, the packages ==========
             Built in code (BackgroundPage.cs): the overview and its pages (desktop, lock screen, a package, an image). -->
        <ScrollViewer x:Name="BackgroundView" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="BackgroundPanel" Margin="32,20,32,32" MaxWidth="1000" />
        </ScrollViewer>

        <!-- ========== Gallery, inside Background ========== -->
        <Grid x:Name="GalleryView" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="32,20,32,14" MaxWidth="1000">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="GalleryBackButton" Style="{StaticResource SecondaryButton}" Click="GalleryBack_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="GalleryBackText" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="GalleryTitle" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,0,32,32" MaxWidth="1000">
                    <TextBlock x:Name="GalleryHelp" Style="{StaticResource Help}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <UniformGrid x:Name="GalleryCards" Columns="3" Margin="-6,0,-6,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ========== Color mode ========== -->
        <ScrollViewer x:Name="ModeView" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ModePanel" Margin="32,20,32,32" MaxWidth="1000" />
        </ScrollViewer>

        <!-- ========== Profiles ========== -->
        <ScrollViewer x:Name="ProfilesView" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ProfilesPanel" Margin="32,20,32,32" MaxWidth="1000" />
        </ScrollViewer>

        <!-- ========== Settings ========== -->
        <ScrollViewer x:Name="SettingsView" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsPanel" Margin="32,20,32,32" MaxWidth="1000" />
        </ScrollViewer>

        <!-- Starting point of scrolling with the middle mouse button (MiddleScroll) -->
        <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
            <Grid x:Name="ScrollMarker" Width="28" Height="28" Visibility="Collapsed">
                <Ellipse Fill="{DynamicResource Pop}" Stroke="{DynamicResource ControlLine}" StrokeThickness="1" />
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70E;" FontSize="8" Foreground="{DynamicResource Text2}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" />
                <Ellipse Width="3" Height="3" Fill="{DynamicResource Text2}" />
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="8" Foreground="{DynamicResource Text2}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
            </Grid>
        </Canvas>

        <!-- Questions, messages and the Undo bar (KitDialog) -->
        <Grid x:Name="DialogLayer" Grid.RowSpan="3" />
    </Grid>
</Window>
