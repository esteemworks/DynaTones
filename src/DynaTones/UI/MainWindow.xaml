<Window x:Class="DynaTones.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kit="clr-namespace:EsteemWorks.Kit.UI;assembly=EsteemWorks.Kit"
        xmlns:ui="clr-namespace:DynaTones.UI"
        Title="DynaTones" Width="1120" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text2}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown">

    <Grid x:Name="Root">
        <!-- The family's window (kit KitFrame): title bar, title with the line of facts, the actions, the tabs with the
             gear, the brand line. Tabs are added in code (MainWindow.xaml.cs); the pages below are the frame's. -->
        <kit:KitFrame x:Name="Frame">
            <kit:KitFrame.Actions>
                <!-- Refresh is a small icon: DynaTones keeps the screen right by itself, this is for when it could not -->
                <Button x:Name="RefreshButton" Style="{StaticResource HeroButton}" Click="Refresh_Click" Margin="0,0,8,0" Width="32" Padding="0">
                    <!-- Turns while it works, at least once, as StartQueue's Check (Motion.SpinWhile) -->
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="RefreshTurn" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>
                <!-- Pause opens how long (its menu, kit KitMenuButton, which draws the chevron); while paused Resume
                     takes its place: a button acts or opens, never both (design system, "Menu buttons") -->
                <Button x:Name="PauseButton" Style="{StaticResource HeroButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE769;" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="PauseText" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ResumeButton" Style="{StaticResource HeroButton}" Click="Resume_Click" Margin="0,0,8,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="ResumeText" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="AddButtonText" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </kit:KitFrame.Actions>
        <!-- ========== Background: what shows now, the way into desktop and lock screen, the packages ==========
             Built in code (BackgroundPage.cs): the overview and its pages (desktop, lock screen, a package, an image). -->
        <ScrollViewer x:Name="BackgroundView" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="BackgroundPanel" Margin="32,20,32,24" MaxWidth="1000" />
        </ScrollViewer>

        <!-- ========== Gallery, inside Background ==========
             Back and title scroll with the page, as on the pages under Background, so they line up with the cards
             whether or not the scroll bar shows. -->
        <ScrollViewer x:Name="GalleryView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,20,32,32" MaxWidth="1000">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button x:Name="GalleryBackButton" Style="{StaticResource SecondaryButton}" Click="GalleryBack_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="GalleryBackText" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="GalleryTitle" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="GalleryHelp" Style="{StaticResource Help}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <UniformGrid x:Name="GalleryCards" Columns="3" Margin="-6,0,-6,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- ========== Color mode ========== -->
        <ScrollViewer x:Name="ModeView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ModePanel" Margin="32,20,32,32" MaxWidth="1000" />
        </ScrollViewer>

        <!-- ========== Profiles ========== -->
        <ScrollViewer x:Name="ProfilesView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ProfilesPanel" Margin="32,20,32,32" MaxWidth="1000" />
        </ScrollViewer>

        <!-- ========== Settings ========== -->
        <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <!-- One column of at most 760 px, as in every app of the family (kit SettingsPage) -->
            <StackPanel x:Name="SettingsPanel" Style="{StaticResource SettingsPage}" />
        </ScrollViewer>

        </kit:KitFrame>

        <!-- Starting point of scrolling with the middle mouse button (MiddleScroll) -->
        <Canvas IsHitTestVisible="False">
            <Grid x:Name="ScrollMarker" Width="28" Height="28" Visibility="Collapsed">
                <Ellipse Fill="{DynamicResource Pop}" Stroke="{DynamicResource ControlLine}" StrokeThickness="1" />
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70E;" FontSize="8" Foreground="{DynamicResource Text2}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" />
                <Ellipse Width="3" Height="3" Fill="{DynamicResource Text2}" />
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="8" Foreground="{DynamicResource Text2}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
            </Grid>
        </Canvas>

        <!-- Questions, messages and the Undo bar (KitDialog) -->
        <Grid x:Name="DialogLayer" />
    </Grid>
</Window>
